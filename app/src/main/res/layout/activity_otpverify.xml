<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ActivityOTPVerify">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="@dimen/dimen_16dp"
        android:padding="@dimen/dimen_16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/TV_PRIMARY_BANNER"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:fontFamily="@font/baloo"
            android:text="@string/VERIFY_OTP"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textSize="@dimen/dimen_32sp"
            app:layout_constraintStart_toEndOf="@id/IMG_ACCOUNT"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dimen_32sp"
            android:gravity="center">

            <EditText
                android:id="@+id/otp_edit_text_1"
                android:layout_width="@dimen/dimen_36dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:hint="0"
                android:layout_margin="@dimen/dimen_8dp"
                android:gravity="center"
                android:padding="@dimen/dimen_4dp"
                android:textSize="@dimen/dimen_32sp"
                android:background="@drawable/otp_background" />

            <EditText
                android:id="@+id/otp_edit_text_2"
                android:layout_width="@dimen/dimen_36dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:hint="0"
                android:layout_margin="@dimen/dimen_8dp"
                android:gravity="center"
                android:padding="@dimen/dimen_4dp"
                android:textSize="@dimen/dimen_32sp"
                android:background="@drawable/otp_background" />

            <EditText
                android:id="@+id/otp_edit_text_3"
                android:layout_width="@dimen/dimen_36dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:hint="0"
                android:layout_margin="@dimen/dimen_8dp"
                android:gravity="center"
                android:padding="@dimen/dimen_4dp"
                android:textSize="@dimen/dimen_32sp"
                android:background="@drawable/otp_background" />

            <EditText
                android:id="@+id/otp_edit_text_4"
                android:layout_width="@dimen/dimen_36dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:hint="0"
                android:layout_margin="@dimen/dimen_8dp"
                android:gravity="center"
                android:padding="@dimen/dimen_4dp"
                android:textSize="@dimen/dimen_32sp"
                android:background="@drawable/otp_background" />

            <EditText
                android:id="@+id/otp_edit_text_5"
                android:layout_width="@dimen/dimen_36dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:hint="0"
                android:textSize="@dimen/dimen_32sp"
                android:layout_margin="@dimen/dimen_8dp"
                android:gravity="center"
                android:padding="@dimen/dimen_4dp"
                android:background="@drawable/otp_background" />

            <EditText
                android:id="@+id/otp_edit_text_6"
                android:layout_width="@dimen/dimen_36dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:layout_margin="@dimen/dimen_8dp"
                android:padding="@dimen/dimen_4dp"
                android:gravity="center"
                android:hint="0"
                android:textSize="@dimen/dimen_32sp"
                android:background="@drawable/otp_background" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/SUBMIT_BTN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_24dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:text="Submit"
            android:textSize="@dimen/dimen_24sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>